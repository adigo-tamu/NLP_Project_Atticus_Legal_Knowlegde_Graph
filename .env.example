# ============================================
# Project Atticus - Environment Configuration
# ============================================

# Application Settings
APP_ENV=development
APP_NAME=project-atticus
LOG_LEVEL=INFO
DEBUG=True

# LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Configuration
PRIMARY_LLM_MODEL=gpt-4o
FALLBACK_LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_RATE_LIMIT=60

# Neo4j Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=legal_kg

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=legal_embeddings

# PostgreSQL (Optional - for metadata)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=atticus_metadata
POSTGRES_USER=atticus
POSTGRES_PASSWORD=your_postgres_password_here

# Redis (for caching and task queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=True
API_SECRET_KEY=your_secret_key_here_change_in_production

# Processing Configuration
MAX_CHUNK_SIZE=1000
CHUNK_OVERLAP=100
BATCH_SIZE=10
MAX_CONCURRENT_DOCS=5
PROCESSING_TIMEOUT=300

# Evaluation Targets
ENTITY_F1_TARGET=0.85
RELATIONSHIP_F1_TARGET=0.70
GRAPH_F1_TARGET=0.40

# Data Paths
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
GRAPH_EXPORT_DIR=./data/graphs
MODELS_DIR=./models

# Logging
LOG_FILE_PATH=./logs/atticus.log
LOG_ROTATION=500 MB
LOG_RETENTION=10 days

# Monitoring
ENABLE_METRICS=True
METRICS_PORT=9090

# Security
ENABLE_AUTH=False
JWT_SECRET_KEY=your_jwt_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Feature Flags
ENABLE_CACHING=True
ENABLE_VECTOR_SEARCH=True
ENABLE_GRAPH_VALIDATION=True
ENABLE_COT_REASONING=True

# External Services
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Experimental Features
USE_LOCAL_MODELS=False
LOCAL_MODEL_PATH=
ENABLE_FINE_TUNING=False
